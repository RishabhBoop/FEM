{
    "version": 8,
    "vendor": {
        "user/project": "FEM"
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "Python_EXECUTABLE": "${sourceDir}/.venv/bin/python"
            }
        }
    ]
}